# ⚠️ WARNING: This connects to the PRODUCTION Neon database.
# Running migrations, seeds, or destructive scripts here affects live data.
# Do NOT run test/experimental scripts against this without extreme caution.
# Copy this file to .env and fill in real values before running the app.

NODE_ENV=development
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require

# Telegram notifications (optional)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# ABA PayWay payment gateway
ABA_PAYWAY_API_KEY=your_api_key
ABA_PAYWAY_MERCHANT_ID=your_merchant_id
ABA_PAYWAY_BASE_URL=https://api.abapayway.com
ABA_PAYWAY_KHR_RATE=4100

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=2d

# Frontend URL (for CORS)
FRONTEND_URL=https://your-app.vercel.app
